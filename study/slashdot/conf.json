{
  "configuration": {
    "collection": {
      "is_completed": false,
      "ignore_old_list": false,
      "sort_field_pattern": "\\t(\\S+)",
      "unit_size_per_day": 2,
      "list_url_list": [
        "https://rss.slashdot.org/Slashdot/slashdotMain"
      ],
      "item_capture_script": "../capture_item_from_rss.py -t -n 100",
      "num_retries": 3,
      "retry_sleep": 30
    },
    "extraction": {
      "render_js": true,
      "browser_fallback": ["cloakbrowser", "camoufox", "patchright", "nodriver", "rebrowser_playwright"],
      "bypass_element_extraction": true
    },
    "rss": {
      "title": "Slashdot",
      "generator": "Terzeron's Feed Generator",
      "copyright": "Copyright (c) Slashdot.org. All Rights Reserved",
      "link": "https://terzeron.com/slashdot.xml",
      "language": "ko"
    }
  }
}
