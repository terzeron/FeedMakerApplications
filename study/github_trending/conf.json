{
  "configuration": {
    "collection": {
      "is_completed": true,
      "ignore_old_list": true,
      "sort_field_pattern": "\\t(\\S+)",
      "window_size": 10,
      "unit_size_per_day": 3,
      "list_url_list": [
        "https://github.com/trending?since=weekly",
        "https://gitbreakout.imbch.dev/api/timeline"
      ],
      "item_capture_script": "./capture_item_link_title.py -t -n 300"
    },
    "extraction": {
      "element_class_list": [
        "markdown-body"
      ]
    },
    "rss": {
      "title": "GitHub 급상승 저장소",
      "generator": "Terzeron's Feed Generator",
      "copyright": "Copyright (c) GitHub, Git Breakout. All Rights Reserved",
      "link": "https://terzeron.com/github_trending.xml",
      "language": "ko"
    }
  }
}
